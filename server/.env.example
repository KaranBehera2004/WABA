PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/waba?retryWrites=true&w=majority
MONGODB_DB=waba
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Bind one Smartping account to one local workspace. Never put these in VITE_* variables.
SMARTPING_WORKSPACE_ID=
SMARTPING_JOURNEY_ID=
SMARTPING_FROM=
SMARTPING_DEPT_ID=
# Document gives <host>/account/enterprise/login. Set your exact account login URL.
SMARTPING_LOGIN_URL=
SMARTPING_EMAIL=
SMARTPING_PASSWORD=
# Alternatively supply a server-side authentication token instead of login credentials.
SMARTPING_AUTH_TOKEN=
# Public HTTPS origin of THIS API (no /api suffix); optional delivery tracking.
SMARTPING_CALLBACK_BASE_URL=
SMARTPING_WEBHOOK_SECRET=

# Encrypted business integration credentials: base64 encoding of 32 random bytes.
BUSINESS_ENCRYPTION_KEY=
# Public HTTPS CRM webhook hosts approved by the server operator, comma-separated.
BUSINESS_WEBHOOK_ALLOWED_HOSTS=
# Safe default. API/dev startup never runs the sending worker.
ENABLE_OUTBOUND_JOBS=false
